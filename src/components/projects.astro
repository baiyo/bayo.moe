---
const projects = [
  { name: 'Lament', category: 'Game development', role: 'Developer & co-owner', desc: 'Full stack development on back end and front end systems', href: 'https://www.roblox.com/games/122655569148354/Lament', icon: 'https://tr.rbxcdn.com/180DAY-e91ffa877133a1be956102efa43f8996/256/256/Image/Webp/noFilter', year: '2025–2026', tags: ['Roblox', 'Lua'], color: 'rose' },
  { name: 'Weak Legacy 2', category: 'Game development', role: 'Full stack developer', desc: 'Full stack development with an emphasis on backend systems.', href: 'https://www.roblox.com/games/18337464872/Weak-Legacy-2', icon: 'https://tr.rbxcdn.com/180DAY-7faae4baf10fd8ec8fb1e264eb1dba5e/256/256/Image/Webp/noFilter', year: '2026', tags: ['Roblox', 'Backend'], color: 'blue' },
  { name: 'My portfolio', category: 'Web development', role: 'A space of my own', desc: "The site you're on right now. A home for my projects.", href: 'https://github.com/baiyo/bayo.moe', icon: '/icon.jpeg', year: 'Personal project', tags: ['Astro', 'CSS'], color: 'violet' },
]
---
<section id="projects" aria-labelledby="projects-title">
  <div class="section-heading"><div><p class="eyebrow">Projects I've worked on</p><h2 id="projects-title">Selected projects</h2></div></div>
  <div class="grid">
    {projects.map(p => (
      <a href={p.href} target="_blank" rel="noopener noreferrer" class={`card ${p.color}`}>
        <div class="card-visual"><img src={p.icon} alt="" width="64" height="64" loading="lazy" /><span class="external" aria-hidden="true">&#8599;</span><span class="category">{p.category}</span></div>
        <div class="card-body"><p class="year">{p.year}</p><h3>{p.name}</h3><p class="role">{p.role}</p><p class="description">{p.desc}</p><div class="tags">{p.tags.map(tag => <span>{tag}</span>)}</div></div>
      </a>
    ))}
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { border: 1px solid var(--color-border); border-radius: 14px; overflow: hidden; background: var(--secondary-bg); display: flex; flex-direction: column; transition: transform .2s, border-color .2s; }
  .card:hover { transform: translateY(-5px); border-color: var(--color-puh); color: var(--color-text); }
  .card-visual { position: relative; height: 144px; padding: 24px; background: radial-gradient(ellipse at 30% 20%, var(--project-tint), transparent 80%), var(--color-glass); border-bottom: 1px solid var(--color-border); }
  .rose { --project-tint: #ce75992b; } .blue { --project-tint: #6ca4da2b; } .violet { --project-tint: #ab8dec2b; }
  .card-visual img { border-radius: 14px; object-fit: cover; box-shadow: 0 8px 20px #0002; }
  .external { position: absolute; top: 18px; right: 20px; color: var(--color-text-muted); font-size: 22px; } .card:hover .external { color: var(--color-puh); }
  .category { position: absolute; bottom: 16px; left: 24px; font: 11px ui-monospace, monospace; color: var(--color-text-muted); }
  .card-body { padding: 22px; display: flex; flex-direction: column; flex: 1; } .year { font: 11px ui-monospace, monospace; margin-bottom: 12px; }
  h3 { font-size: 20px; margin-bottom: 8px; } .role { font-size: 12px; color: var(--color-puh); margin-bottom: 12px; } .description { font-size: 13px; line-height: 1.8; margin-bottom: 24px; }
  .tags { display: flex; gap: 6px; margin-top: auto; } .tags span { font: 10px ui-monospace, monospace; border: 1px solid var(--color-border); padding: 4px 8px; border-radius: 5px; color: var(--color-text-muted); }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } .card { flex-direction: row; } .card-visual { height: auto; width: 150px; flex-shrink: 0; border-bottom: 0; border-right: 1px solid var(--color-border); } .category { max-width: 110px; } .external { top: auto; bottom: 40px; } .card-body { padding: 20px; } }
  @media (max-width: 500px) { .card-visual { width: 100px; padding: 16px; } .category { left: 12px; max-width: 80px; font-size: 10px; } .card-visual img { width: 56px; height: 56px; } }
  @media (max-width: 350px) { .card { flex-direction: column; } .card-visual { width: 100%; height: 110px; border-right: 0; border-bottom: 1px solid var(--color-border); } .category { bottom: 16px; left: 90px; max-width: none; } .external { bottom: auto; top: 16px; } }
</style>
