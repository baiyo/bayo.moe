---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props { title: string }
const { title } = Astro.props

import cat from '../assets/CATT.gif'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bao's little corner of the internet. Self-taught developer in New Zealand, building games and things for the web." />
    <title>{title}</title>
    <link rel="icon" href='/icon.jpeg' />
    <ClientRouter />



    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.setAttribute('data-theme', 'light')
      } catch {}
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="site-shell"><slot /></div>
    <img class="cat" src={cat.src} alt="" aria-hidden="true" transition:persist />
  </body>

  <style>
      .cat {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        width: 100px;
        image-rendering: pixelated;
        z-index: 99;
        pointer-events: none;
      }
      @media (max-width: 1100px) { .cat { width: 64px; bottom: 8px; right: 8px; } }
      @media (prefers-reduced-motion: reduce) { .cat { display: none; } }
  </style>

</html>
